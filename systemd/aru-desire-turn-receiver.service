[Unit]
Description=Aru Desire complete-message receiver
After=local-fs.target
ConditionPathExists=/var/lib/aru-desire-heartbeat/interaction-state.json
ConditionPathExists=/var/lib/aru-desire-heartbeat/turn-hook.secret

[Service]
Type=simple
User=aru-desire
Group=aru-desire
UMask=0077
Environment=ARU_DESIRE_RECEIVER_HOST=127.0.0.1
Environment=ARU_DESIRE_RECEIVER_PORT=18761
Environment=ARU_DESIRE_CONFIG=/opt/aru-desire-heartbeat/config/default.json
Environment=ARU_DESIRE_DATA_DIR=/var/lib/aru-desire-heartbeat
Environment=ARU_DESIRE_TURN_HOOK_SECRET_FILE=/var/lib/aru-desire-heartbeat/turn-hook.secret
WorkingDirectory=/opt/aru-desire-heartbeat
ExecStart=/usr/bin/node /opt/aru-desire-heartbeat/bin/desire-turn-receiver.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET
ReadWritePaths=/var/lib/aru-desire-heartbeat

[Install]
WantedBy=multi-user.target
